    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "brace-expansion@1": "^1.1.22",
    "glob@>=9 <14.0.2": "^14.0.5",
    "minimatch@>=7 <11.0.1": "^11.0.8"
