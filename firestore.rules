rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // NOTE: There is intentionally NO catch-all `match /{document=**}`
    // read rule. Firestore rules are additive (OR), so a wildcard
    // `allow read: if true` would silently override every narrower rule
    // below. Reads are granted per-collection instead.
    //
    // ADMIN GATING: player docs are keyed by player id (e.g. "pShane"),
    // NOT by Firebase Auth uid, so rules cannot look an admin up by path
    // (`get(/players/$(uid))` never resolves). There is therefore no
    // working `isAdmin()` available to security rules. Admin-only writes
    // are enforced server-side in callable Cloud Functions (which query
    // players by `authUid` and check `isAdmin`). To gate *reads* on admin
    // status (e.g. to hide `test` tournaments from the public) you would
    // need a path-addressable admin registry, e.g. `config/admins.uids`,
    // that rules can `get()`. Until that exists, tournaments are public.
    // ------------------------------------------------------------------

    // Tournaments: public read, server-only write.
    // (The previous `test != true || isAdmin()` gate was a no-op: isAdmin()
    // can't resolve in rules — see note above — so it only ever evaluated to
    // `test != true`, and the old `/{document=**}` wildcard made it moot anyway.
    // Kept public to avoid breaking the admin test-tournament listing.)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if false; // Use Firestore console or seed scripts
    }

    // Players collection: public read (display names / photos / handicaps are
    // shown app-wide, including to logged-out visitors on the public leaderboard).
    // The doc still carries `authUid` (an opaque Firebase UID kept here because
    // it's the query key for authUid==uid lookups) but the sensitive PII — email
    // and free-text scoutingNotes — now lives in the server-only
    // players/{id}/private subcollection below, so it is NOT world-readable.
    //
    // Writes are fully server-only. Account linking (writing authUid/email) is
    // done exclusively by admins via the linkAuthToPlayer callable (Admin SDK,
    // which bypasses these rules); no client ever writes a top-level player doc,
    // so there is no self-link branch to abuse. (The previous self-link rule let
    // any signed-in user claim an unlinked player's authUid — including an
    // unlinked admin's — which the callable-only path closes.)
    match /players/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    // Private per-player PII (players/{id}/private/{doc}): email + scoutingNotes.
    // Server-only in every direction — the Admin SDK (admin callables, e.g. the
    // getPlayerPrivate reader) reads/writes it, and no client path is allowed, so
    // these fields are never exposed to anonymous or ordinary signed-in readers.
    match /players/{playerId}/private/{doc} {
      allow read, write: if false;
    }

    // Per-player notification history (players/{id}/notifications/{id}): drives
    // the in-app notification bell + unread badges. Unlike the admin case, the
    // owning playerId is in the PATH, so rules CAN resolve ownership by reading
    // that player doc's authUid. Owner-only read; owner may flip a notification
    // to read (and only the read/readAt fields) or dismiss it from their bell by
    // deleting it. All creates come from the server (notify() via the Admin SDK),
    // which bypasses these rules.
    match /players/{playerId}/notifications/{notifId} {
      function isOwner() {
        return request.auth != null
          && get(/databases/$(database)/documents/players/$(playerId)).data.authUid == request.auth.uid;
      }
      allow read: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isOwner();
      allow create: if false;
    }

    // Matches: public read; rostered players (or an open tournament) may edit
    // ONLY the `holes` map — never status/result/authorizedUids/roster/handicaps.
    // Cloud Functions write those via the Admin SDK, which bypasses these rules.
    match /matches/{matchId} {
      // Check if user is authorized using pre-computed authorizedUids array
      // This avoids expensive player document reads in security rules
      function isAuthorizedPlayer() {
        return request.auth != null &&
               resource.data.keys().hasAny(['authorizedUids']) &&
               request.auth.uid in resource.data.authorizedUids;
      }

      // Allow public edits if the tournament explicitly enables openPublicEdits
      function isTournamentOpen() {
        // Determine tournamentId from existing resource or incoming request without using 'if/else'
        let tid = resource.data.tournamentId != null ? resource.data.tournamentId : (request.resource != null && request.resource.data.tournamentId != null ? request.resource.data.tournamentId : null);
        return tid != null &&
               exists(/databases/$(database)/documents/tournaments/$(tid)) &&
               get(/databases/$(database)/documents/tournaments/$(tid)).data.openPublicEdits == true;
      }

      // Field-level guard: clients may only mutate the `holes` map.
      // The score-entry UI writes `holes.{N}.input`; affectedKeys() reports the
      // top-level key `holes` for nested writes.
      function onlyHolesChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['holes']);
      }

      // Shape guard: `holes` must stay a map, and a write may never DROP an
      // existing hole key. affectedKeys() can't tell a surgical `holes.5.input`
      // update from a full-map replacement, so without this a single client
      // could overwrite `holes` with `{ "5": {...} }` and wipe every other
      // hole's already-entered scores. Per-hole score VALUE validation is left
      // to the server (isValidGross in computeMatchOnWrite) — the nested,
      // format-specific shapes are impractical to validate in rules.
      function holesShapeValid() {
        return request.resource.data.holes is map
          && request.resource.data.holes.keys().hasAll(resource.data.get('holes', {}).keys());
      }

      allow read: if true;
      // `locked != true` enforces the admin per-match lock (set via the
      // setMatchLock callable); undefined/false on existing docs passes.
      allow update: if (isAuthorizedPlayer() || isTournamentOpen())
        && onlyHolesChanged()
        && holesShapeValid()
        && resource.data.get('locked', false) != true;
      allow create, delete: if false;
    }

    // Rounds (+ skinsResults subcollection): public read, server-only write
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if false;
    }
    match /rounds/{roundId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // SIDE EVENTS — the optional, non-scoring 9-hole game (3-man scramble).
    // Deliberately NOT modelled as rounds/matches: every scoring, stats,
    // skins and betting trigger fires on `matches/{matchId}`, so staying out
    // of that collection is what guarantees this game awards no Cup points
    // and generates no player stats.
    // ------------------------------------------------------------------

    // Side event config (name, course, nine, payouts, lock): public read,
    // server-only write via the sideEventOps callables.
    match /sideEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Side event teams. This is the SECOND client-writable collection (after
    // `matches`) and follows exactly the same shape: a rostered member may
    // update the `holes` map and nothing else. It is a top-level collection
    // rather than a `sideEvents` subcollection specifically so this write path
    // exists — score entry has to be a direct client write for Firestore's
    // offline queue to carry it, the same way the match scorecard works.
    match /sideEventTeams/{teamId} {
      // The team's own players, resolved server-side into auth uids by
      // saveSideEventTeam (mirrors match.authorizedUids).
      function isTeamMember() {
        return request.auth != null
          && request.auth.uid in resource.data.get('authorizedUids', []);
      }

      // Field-level guard: only the `holes` map may change.
      function onlyHolesChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['holes']);
      }

      // Shape guard: `holes` stays a map and a write may never DROP an existing
      // hole key. affectedKeys() can't distinguish a surgical `holes.12.gross`
      // update from a full-map replacement, so without this one client could
      // wipe every other hole already entered. Score VALUES are validated
      // client-side and by the admin fix-up callable; the rule only protects
      // the shape.
      function holesShapeValid() {
        return request.resource.data.holes is map
          && request.resource.data.holes.keys().hasAll(resource.data.get('holes', {}).keys());
      }

      allow read: if true;
      // `locked` is denormalized onto each team doc by updateSideEvent so this
      // check needs no cross-document get() on every score save.
      allow update: if isTeamMember()
        && onlyHolesChanged()
        && holesShapeValid()
        && resource.data.get('locked', false) != true;
      allow create, delete: if false;
    }

    // Courses: public read, server-only write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    // Player match facts: public read, server-only write (computed by functions)
    match /playerMatchFacts/{factId} {
      allow read: if true;
      allow write: if false;
    }

    // Aggregated player stats (+ bySeries/byTournament/byRound subcollections):
    // public read, server-only write.
    match /playerStats/{playerId} {
      allow read: if true;
      allow write: if false;
    }
    match /playerStats/{playerId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Collection-group read for the `byTournament` stats query used by Teams.tsx
    // (collectionGroup queries require an explicit recursive-wildcard rule).
    match /{path=**}/byTournament/{statId} {
      allow read: if true;
    }

    // Collection-group read for the `bySeries` stats query used by the All-Time
    // leaderboard (useAllTimeLeaderboard). Same as byTournament: collectionGroup
    // queries need their own recursive-wildcard rule; the path-based playerStats
    // rule above only covers direct-path reads. These docs are already public-read.
    match /{path=**}/bySeries/{statId} {
      allow read: if true;
    }

    // Round recaps: public read, server-only write
    match /roundRecaps/{recapId} {
      allow read: if true;
      allow write: if false;
    }

    // Sportsbook bets: SIGNED-IN read only. The marketplace of open offers and
    // the shared who-owes-whom ledger reveal who wagered what against whom, so
    // they're private to the group — not readable by anonymous visitors. The
    // /sportsbook page is also gated client-side (RequireAuth). All mutations go
    // through the betsOps callables via the Admin SDK — clients never write here.
    match /bets/{betId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Settle-up records (betSettlements/{id}): signed-in read like bets (the
    // who-paid-whom tab is part of the same private ledger). All mutations go
    // through the settlementOps callables via the Admin SDK — no client writes.
    match /betSettlements/{settlementId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Comments: SIGNED-IN read only. Match threads + the sportsbook trash-talk
    // feed are the group's private conversation, not for anonymous visitors (the
    // /chat page and the match-page thread are gated client-side too). All
    // mutations go through the commentOps callables via the Admin SDK — clients
    // never write here directly. One-level replies live in a `replies`
    // subcollection (also signed-in read, server-only write); subcollection rules
    // are NOT inherited, so it needs its own match block.
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /comments/{commentId}/replies/{replyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pairings draft. Each draft carries a `visibility` set by an admin:
    //
    //   live (default)  any signed-in user can follow along, which is what makes
    //                   the full-screen /pairings-tv broadcast watchable by the
    //                   whole field while the picks happen.
    //   private         only the captains/co-captains/admins the server stamped
    //                   into authorizedUids can read it, so a round can be
    //                   drafted out of sight and revealed later by an admin
    //                   flipping it back to live. This has to be enforced here —
    //                   hiding the UI alone would leave the picks readable.
    //
    // Drafts written before `visibility` existed have no such field, so a missing
    // value means live (unchanged behaviour). `resource == null` keeps a read of
    // a round that has no draft yet resolving to "empty" rather than denied.
    // Writes only ever happen through the admin-gated draftOps callables via the
    // Admin SDK, which bypasses these rules.
    match /pairingDrafts/{roundId} {
      allow read: if request.auth != null
                  && (resource == null
                      || resource.data.get('visibility', 'live') != 'private'
                      || resource.data.get('authorizedUids', []).hasAny([request.auth.uid]));
      allow write: if false;
    }

    // Captains' private pairing plans (pairingPlans/{roundId}__{team}): one
    // team's own pre-draft scratchpad. The opposite of pairingDrafts above —
    // a plan the other side can read is worthless, so reads are limited to the
    // captain/co-captain uids the server stamped into authorizedUids (a
    // tournament admin gets in only if they hold one of those roles). Writes go
    // through the savePairingPlan callable via the Admin SDK.
    match /pairingPlans/{planId} {
      allow read: if request.auth != null
                  && resource.data.keys().hasAny(['authorizedUids'])
                  && request.auth.uid in resource.data.authorizedUids;
      allow write: if false;
    }
  }
}
